+def _generate_ktel_snapshots(
+    out_dir: Path,
+    db_path: str,
+    public_db_path: str,
+) -> dict[str, Any]:
+    """Build one immutable KTEL registry release from the isolated KTEL DB."""
+    with ktel_db.connect(db_path) as conn:
+        ktel_db.migrate(conn)
+        ktel_registry.seed_registry(conn)
+    publication = ktel_publish.compile_public_database(
+        ingest_db_path=db_path,
+        public_db_path=public_db_path,
+    )
+    with ktel_db.connect(public_db_path, read_only=True) as conn:
+        operators = ktel_api.registry_payload(conn)
+        coverage = ktel_api.coverage_payload(conn)
+        sources = ktel_api.sources_payload(conn)
+
+    directory = out_dir / "ktel"
+    release_id = publication["releaseId"]
+    operators_name = f"{release_id}-operators.json"
+    coverage_name = f"{release_id}-coverage.json"
+    sources_name = f"{release_id}-sources.json"
+    operators_hash = _atomic_write_json(directory / operators_name, operators)
+    coverage_hash = _atomic_write_json(directory / coverage_name, coverage)
+    sources_hash = _atomic_write_json(directory / sources_name, sources)
+    manifest = {
+        "schemaVersion": 1,
+        "releaseId": release_id,
+        "updatedAt": operators["updatedAt"],
+        "completeness": "registry_complete_timetables_partial",
+        "files": {
+            "operators": {
+                "path": f"packs/{operators_name}",
+                "sha256": operators_hash,
+            },
+            "coverage": {
+                "path": f"packs/{coverage_name}",
+                "sha256": coverage_hash,
+            },
+            "sources": {
+                "path": f"packs/{sources_name}",
+                "sha256": sources_hash,
+            },
+        },
+    }
+    manifest_path = directory / "manifest.json"
+    if manifest_path.exists():
+        previous = directory / "manifest.previous.json"
+        previous_tmp = directory / "manifest.previous.json.tmp"
+        shutil.copy2(manifest_path, previous_tmp)
+        os.replace(previous_tmp, previous)
+    manifest_hash = _atomic_write_json(manifest_path, manifest)
+    return {
+        "releaseId": release_id,
+        "manifestHash": manifest_hash,
+        "files": [
+            "ktel/manifest.json",
+            f"ktel/{operators_name}",
+            f"ktel/{coverage_name}",
+            f"ktel/{sources_name}",
+        ],
+    }


