+# National KTEL coach API. It reads from the isolated KTEL database and never
+# runs migrations on a public request path. Ingestion and publication remain
+# scheduled operator workflows, not user-triggered upstream calls.
+
+@contextmanager
+def get_ktel_db_readonly() -> Iterator[Any]:
+    try:
+        conn = ktel_db.connect(
+            ktel_db.DEFAULT_KTEL_PUBLIC_DB_PATH,
+            read_only=True,
+        )
+    except Exception as exc:
+        raise HTTPException(
+            status_code=503, detail="KTEL registry is not initialized"
+        ) from exc
+    try:
+        manifest_path = Path(
+            os.environ.get(
+                "SYRMOS_KTEL_MANIFEST_PATH",
+                str(
+                    Path(
+                        os.environ.get(
+                            "SYRMOS_API_OUT_DIR",
+                            Path(__file__).resolve().parent.parent / "out",
+                        )
+                    )
+                    / "ktel"
+                    / "manifest.json"
+                ),
+            )
+        )
+        db_release_id = ktel_api.release_id(conn)
+        manifest_release_id = None
+        for _ in range(2):
+            try:
+                manifest_release_id = json.loads(
+                    manifest_path.read_text(encoding="utf-8")
+                ).get("releaseId")
+            except (FileNotFoundError, OSError, ValueError):
+                manifest_release_id = None
+            if manifest_release_id == db_release_id and db_release_id:
+                break
+        if not db_release_id or manifest_release_id != db_release_id:
+            raise HTTPException(
+                status_code=503,
+                detail="KTEL publication is switching releases",
+                headers={"Retry-After": "1"},
+            )
+        yield conn
+    finally:
+        conn.close()
+
