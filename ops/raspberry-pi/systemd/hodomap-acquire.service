[Unit]
Description=HodoMap bounded daily source acquisition
Documentation=https://github.com/peterdsp/HodoMap
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/hodomap/data/operators/registry.json

[Service]
Type=oneshot
WorkingDirectory=%h/hodomap
EnvironmentFile=-%h/.config/hodomap/acquisition.env
ExecStart=%h/hodomap/ops/raspberry-pi/run-acquisition.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
