# HodoMap daily source monitor.
HODOMAP_CONTACT_EMAIL=info@peterdsp.dev
HODOMAP_MAX_REQUESTS=100
HODOMAP_MIN_HOST_INTERVAL_SECONDS=1.5
HODOMAP_JITTER_SECONDS=0.3
HODOMAP_TIMEOUT_SECONDS=20

# TicketWeb remains disabled until written terms and reuse permission exist.
HODOMAP_TICKETWEB_TERMS_APPROVED=0

# Runtime paths are outside the repository.
HODOMAP_DATA_ROOT=/home/peterdsp/.local/share/hodomap
HODOMAP_REPORT_ROOT=/home/peterdsp/.local/state/hodomap/reports
